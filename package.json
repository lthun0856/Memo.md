{
  "name": "memo.md",
  "version": "0.24.0",
  "description": "바탕화면 메모장 - MD내보내기",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --x64"
  },
  "author": "NEMO",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.taehoon.obsidianmemo",
    "productName": "Memo.md",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "files": [
      "**/*",
      "!data/**",
      "!인계서/**",
      "!CAL/**",
      "!screenshots/**",
      "!test-data/**",
      "!icontest/**",
      "!디자인시안/**",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}/**",
      "!node_modules/koffi/{src,vendor,doc,lib}/**",
      "!node_modules/koffi/build/koffi/win32_x64/*.{exp,lib}",
      "!_to_delete/**",
      "!_mount_live_test.txt",
      "!README.md"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/koffi/build/koffi/win32_x64/**"
    ]
  },
  "dependencies": {
    "koffi": "2.16.3",
    "korean-lunar-calendar": "^0.4.0"
  }
}
